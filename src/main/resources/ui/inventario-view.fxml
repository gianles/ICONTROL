<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.icontrol.ui.InventarioController">

    <!-- PARTE SUPERIOR: título + botones -->
    <top>
        <VBox spacing="8">
            <Label text="ICONTROL - Inventario de productos"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 10 10 0 10;"/>

            <!-- Mini-dashboard -->
            <HBox spacing="10">
                <VBox spacing="3"
                      style="-fx-background-color: #f5f5f5; -fx-padding: 8; -fx-border-color: #dddddd; -fx-border-radius: 4; -fx-background-radius: 4;">
                    <Label text="Productos" style="-fx-font-weight: bold;"/>
                    <Label fx:id="lblStatProductos" text="Productos&#10;0"/>
                </VBox>

                <VBox spacing="3"
                      style="-fx-background-color: #f5f5f5; -fx-padding: 8; -fx-border-color: #dddddd; -fx-border-radius: 4; -fx-background-radius: 4;">
                    <Label text="Stock bajo" style="-fx-font-weight: bold;"/>
                    <Label fx:id="lblStatStockBajo" text="Stock bajo&#10;0"/>
                </VBox>

                <VBox spacing="3"
                      style="-fx-background-color: #f5f5f5; -fx-padding: 8; -fx-border-color: #dddddd; -fx-border-radius: 4; -fx-background-radius: 4;">
                    <Label text="Ventas hoy" style="-fx-font-weight: bold;"/>
                    <Label fx:id="lblStatVentasHoy" text="Ventas hoy&#10;0"/>
                </VBox>
            </HBox>


            <ToolBar>
                <Button text="Actualizar" onAction="#onActualizarClick"/>
                <Button text="Nuevo" onAction="#onNuevoClick"/>
                <Button text="Editar" onAction="#onEditarClick"/>
                <Button text="Eliminar" onAction="#onEliminarClick"/>
                <Separator/>
                <Button text="Proveedores" onAction="#onProveedoresClick"/>
                <!-- NUEVO BOTÓN -->
                <Button text="Nuevo cliente" onAction="#onNuevoClienteGlobalClick"/>
                <Button text="Clientes" onAction="#onClientesClick"/>
                <Button text="Nueva venta" onAction="#onNuevaVentaClick"/>
                <Button text="Historial ventas" onAction="#onHistorialVentasClick"/>
            </ToolBar>
        </VBox>
    </top>


    <!-- CENTRO: tabla de productos -->
    <center>
        <TableView fx:id="tablaProductos">
            <columns>
                <TableColumn fx:id="colReferencia" text="Referencia" prefWidth="150"/>
                <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="300"/>
                <TableColumn fx:id="colPvp" text="PVP" prefWidth="80"/>
                <TableColumn fx:id="colStock" text="Stock" prefWidth="80"/>
                <TableColumn fx:id="colStockMinimo" text="Stock mínimo" prefWidth="100"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <Label fx:id="statusLabel"
               text=""
               style="-fx-padding: 6 12 6 12; -fx-background-color: #e0e0e0; -fx-text-fill: #333;"/>
    </bottom>

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>
</BorderPane>
